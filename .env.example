# Copy to .env.local and fill in. The Makefile reads .env.local; it is not committed.
# Plain KEY=value lines: no quotes, no `export`.

# Cloudflare Pages project name. Pages are served from https://<project>.pages.dev.
CUBBY_PAGES_PROJECT=

# Optional. Base URL that `make list` prints. Defaults to https://<project>.pages.dev.
# CUBBY_BASE_URL=https://pages.example.com
